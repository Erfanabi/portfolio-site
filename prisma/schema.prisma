generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// نمونه‌کارها
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  content     String
  coverImage  String?
  client      String?
  role        String?
  year        String?
  liveUrl     String?
  repoUrl     String?
  category    String   @default("web")
  stack       String   @default("")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

/// پیام‌های فرم تماس
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  body      String
  ip        String?
  userAgent String?
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([archived, createdAt])
}
