# رشتهٔ اتصال Postgres — روی Vercel نسخهٔ pooled را بگذار
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# رمز ورود به پنل ادمین — این را عوض کن
ADMIN_PASSWORD=""

# کلید امضای کوکی نشست — یک رشتهٔ تصادفی بلند بگذار
AUTH_SECRET=""

# آدرس عمومی سایت (برای sitemap و متادیتا)
NEXT_PUBLIC_SITE_URL="http://localhost:4321"

# اعلان تلگرام برای پیام‌های فرم تماس (اختیاری)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
